# --- Serveur ---------------------------------------------------------------
PORT=3000

# Cle partagee avec le terminal (--dart-define=API_KEY=...)
TERMINAL_API_KEY=changez-moi-terminal
# Cle separee pour GET /api/deliveries (audit)
ADMIN_API_KEY=changez-moi-admin

# --- Donnees ---------------------------------------------------------------
EMPLOYEES_CSV=./data/employees.csv
DB_PATH=./data/deliveries.db

# --- Messagerie ------------------------------------------------------------
# true = rien n'est envoye, tout est affiche dans la console (tests)
MAIL_DRY_RUN=true

SMTP_HOST=smtp.frigemo.ch
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_STRICT=true

MAIL_FROM="Reception Cressier <reception.cressier@frigemo.ch>"
MAIL_REPLY_TO=
# Copie pour la marchandise refrigeree (logistique)
MAIL_URGENT_CC=
